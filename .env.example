# Optional credentials increase API limits. Never commit real values.
# Used only when a Hugging Face source explicitly sets auth_env = "HF_TOKEN".
HF_TOKEN=
OPENALEX_API_KEY=
# Required to activate complete Semantic Scholar release/diff ingestion.
S2_API_KEY=
# Optional: activates bounded exact-arXiv-ID alphaXiv enrichment during `modelome daily`.
ALPHAXIV_API_KEY=
# Optional: raises the public GitHub repository-enrichment quota.
# Use a least-privilege token; private repositories remain excluded by default.
GITHUB_TOKEN=

# Example only. If you adapt and enable the provider example source, replace this
# with the environment-variable name required by that source configuration.
EXAMPLE_PROVIDER_MODELS_TOKEN=

# Runtime paths and identity.
MODELOME_STORE=data/store
MODELOME_LAKE=data/lake
# Optional: override the catalog bundled with the installed package.
# MODELOME_SOURCES=/path/to/sources.toml
# Optional OpenAlex compatibility/contact parameter; use OPENALEX_API_KEY for quota.
MODELOME_CONTACT_EMAIL=
MODELOME_FRONTIER_LIMIT=200
MODELOME_FRONTIER_MAX_DEPTH=1
